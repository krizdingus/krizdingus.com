    box-shadow: 0 0 4px #2f7a2a, inset 0 0 2px rgba(0,0,0,0.4);
  }
  body.mediakruzer-page .app-statusbar .led.buffering { background: #d6c11a; box-shadow: 0 0 4px #d6c11a; animation: ledPulse 0.7s steps(2,end) infinite; }
  body.mediakruzer-page .app-statusbar .led.idle { background: #6b6660; box-shadow: none; }
  @keyframes ledPulse { 50% { opacity: 0.35; } }
  body.mediakruzer-page .app-statusbar .meter {
    display: inline-flex; gap: 1px; vertical-align: middle;
  }
  body.mediakruzer-page .app-statusbar .meter i {
    width: 3px; height: 8px; background: var(--mk-vu-low);
    display: inline-block;
  }
  body.mediakruzer-page .app-statusbar .meter i:nth-child(3) { background: var(--mk-vu-mid); }
  body.mediakruzer-page .app-statusbar .meter i:nth-child(4),
  body.mediakruzer-page .app-statusbar .meter i:nth-child(5) { background: var(--mk-vu-hi); }

  /* Banner: "Open in [App ↩]" — pseudo-OS taskbar marker */
  body.mediakruzer-page .app-breadcrumb {
    display: flex; align-items: center; gap: 8px;
    padding: 6px var(--space-md) 0;
    font-family: var(--font-mono); font-size: 11px;
    color: var(--text-secondary);
  }
  body.mediakruzer-page .app-breadcrumb .pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 2px 8px;
    background: var(--bg-panel);
    border: 2px solid;
    border-color: var(--bevel-edge) var(--bevel-light) var(--bevel-light) var(--bevel-edge);
    font-family: var(--font-pixel); font-size: 9px;
    letter-spacing: var(--tracking-pixel);
    color: var(--accent-primary);
  }
  body.mediakruzer-page .app-breadcrumb .pill::before {
    content: ''; width: 8px; height: 8px;
    background: linear-gradient(135deg, #ffd86b, #c92e2e);
    border: 1px solid var(--bevel-edge);
