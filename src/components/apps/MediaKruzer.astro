  body.mediakruzer-page .app-breadcrumb .sep { color: var(--text-muted); }

  /* Reduced motion: kill animations */
  @media (prefers-reduced-motion: reduce) {
    body.mediakruzer-page .vis-overlay .bar,
    body.mediakruzer-page .vu-meter.is-on .vb { transition: none !important; }
    body.mediakruzer-page .app-statusbar .led.buffering,
    body.mediakruzer-page .app-breadcrumb .pill::after { animation: none !important; }
