  body.mediakruzer-page .desktop-taskbar .tb-window.mk-tb .mk-tb-icon {
    display: inline-block; width: 14px; height: 14px;
    background: linear-gradient(135deg, #ffd86b, #c92e2e);
    border: 1px solid #1a1c1c;
    position: relative;
    flex: none;
