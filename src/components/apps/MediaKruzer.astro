    font-family: var(--font-mono); font-weight: 700; font-size: 12px;
    position: relative;
  }
  body.mediakruzer-page .ctl:hover { filter: brightness(1.05); }
  body.mediakruzer-page .ctl:active, body.mediakruzer-page .ctl[aria-pressed="true"] {
    border-color: var(--bevel-edge) var(--bevel-light) var(--bevel-light) var(--bevel-edge);
    background: color-mix(in oklab, var(--bg-panel) 88%, #000);
