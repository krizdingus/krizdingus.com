  }
  body.mediakruzer-page .app-statusbar .seg:first-child { box-shadow: none; }
  body.mediakruzer-page .app-statusbar .seg:last-child { border-right: 0; margin-left: auto; }
  body.mediakruzer-page .app-statusbar .led {
    width: 8px; height: 8px; background: #2f7a2a;
