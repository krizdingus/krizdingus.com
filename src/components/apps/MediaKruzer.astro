  body.mediakruzer-page .pl-row .pl-title {
    min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  body.mediakruzer-page .pl-row .pl-title .pl-artist {
    display: block; font-size: 10px; opacity: 0.75;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  body.mediakruzer-page .pl-row.is-current .pl-title .pl-artist { color: #fff; }
  body.mediakruzer-page .pl-row .pl-dur {
    font-family: var(--font-crt); font-size: 13px;
    color: var(--text-muted);
  }
  body.mediakruzer-page .pl-row.is-current .pl-num::before {
    content: '▸ '; color: var(--mk-lcd-ink);
  }
  /* Dark mode: the player's panel (--bg-panel) stays cream, but the text
     tokens and the lavender accent flip light. Pin them so the selected row,
     the toolbar label and the status bar keep AA contrast. */
  [data-theme="dark"] body.mediakruzer-page .pl-toolbar .lab { color: #404242; }
  [data-theme="dark"] body.mediakruzer-page .app-statusbar { color: #272929; }

  body.mediakruzer-page .pl-toolbar {
    display: flex; align-items: center; gap: 4px;
    padding: 4px 6px;
    background: var(--bg-panel);
    border-top: 2px solid var(--bevel-edge);
