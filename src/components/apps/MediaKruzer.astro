---
// src/components/apps/MediaKruzer.astro
// Renders the WMP-style media player chrome + transport + visualization
// placeholder + playlist. The playlist (titles and artists, hardcoded in
// public/apps/mediakruzer/tracks.json) is rendered at build time; nothing
// is fetched to name a track. YouTube (the IFrame API, thumbnails, the
// player) loads only when the visitor presses play or picks a track.
//
// It renders inside the iframe of an XP app window (/apps/mediakruzer/embed/,
// opened by src/themes/xp/apps.ts, which also owns drag/min/max/close).
// The current track and position live in sessionStorage, so the player
// reopens on the next page where it was, paused.
import tracks from '../../../public/apps/mediakruzer/tracks.json';

export interface Props {
  slug: string;
  embed: boolean;
  entry: any;
}

interface Track { id: string; title: string; artist: string; dur: string | null }
// Typographic apostrophes on screen, like the rest of the site's copy
// ("Choosin’ Texas"); tracks.json keeps the titles as YouTube lists them.
const curly = (s: string) => s.replace(/'/g, '\u2019');
const playlist = (tracks as Track[]).map((t) => ({ id: t.id, title: curly(t.title), artist: curly(t.artist), dur: t.dur ?? '' }));
---

<section class="app-window kw-app kw-app--mk mk-floating" id="mk-window" aria-label="MediaKruzer 7.0 video player">

  <!-- App title bar — same chrome class set as the .os-shell. -->
  <div class="title-bar">
    <div class="title-label">
      <span class="exe-icon kw-exe kw-exe--mk" aria-hidden="true"></span>
      <span>MEDIAKRUZER 7.0</span>
      <span class="sep">—</span>
      <span class="now" id="mk-now-title">[Now Playing] {playlist[0]?.title}</span>
    </div>
    <div class="window-controls">
      <button class="window-btn" data-act="min" aria-label="Minimize" title="Minimize"><span class="win-glyph win-glyph-min" aria-hidden="true"></span></button>
      <button class="window-btn" data-act="max" aria-label="Maximize" title="Maximize"><span class="win-glyph win-glyph-max" aria-hidden="true"></span></button>
      <button class="window-btn window-btn-close" data-act="close" aria-label="Close" title="Close"><span class="win-glyph win-glyph-close" aria-hidden="true"></span></button>
    </div>
  </div>

  <!-- App body — player + playlist (no tab strip; this app is just the player) -->
  <div class="app-body mk-body">

    <!-- LEFT: player stage -->
    <div class="player-stage">

      <div class="video-frame" id="mk-frame">
        <!-- The IFrame API replaces this <div> with its own <iframe>. -->
        <div id="mk-yt" title="MediaKruzer video output"></div>
        <div class="scanlines" aria-hidden="true"></div>
        <div class="vignette" aria-hidden="true"></div>
        <div class="vis-overlay" id="mk-vis" aria-hidden="true">
          <!-- 24 bars, animated by JS while playing -->
        </div>
        <div class="corner-stamp">◊ MEDIAKRUZER 7.0 ◊</div>
        <button type="button" class="mk-nosignal" id="mk-nosignal">
          <span class="mk-nosignal__big">NO SIGNAL</span>
          <span class="mk-nosignal__small">press ▶ to tune in · YouTube loads then, not before</span>
        </button>
      </div>

      <!-- Now-playing meta strip -->
      <div class="now-playing">
        <div class="np-art" id="mk-art" aria-hidden="true">▣</div>
        <div class="np-meta">
          <div class="np-title" id="mk-meta-title">{playlist[0]?.title}</div>
          <div class="np-sub" id="mk-meta-sub">{playlist[0]?.artist}</div>
          <div class="np-stats" id="mk-meta-stats">
            <span class="ok">●</span> source: YouTube
          </div>
        </div>
        <div class="vu-meter" id="mk-vu" aria-hidden="true">
          <span class="vb"></span><span class="vb"></span><span class="vb"></span>
          <span class="vb"></span><span class="vb"></span><span class="vb"></span>
          <span class="vb"></span><span class="vb"></span><span class="vb"></span>
          <span class="vb"></span>
        </div>
      </div>

      <!-- Transport: seek row + controls row -->
      <div class="transport" role="group" aria-label="Playback controls">
        <div class="seek-row">
          <span class="lcd" id="mk-lcd-pos">00:00</span>
          <div class="scrub" id="mk-scrub" role="slider" tabindex="0"
               aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="buffer" id="mk-buffer"></div>
            <div class="progress" id="mk-progress"></div>
            <div class="thumb" id="mk-thumb"></div>
          </div>
          <span class="lcd" id="mk-lcd-dur">00:00</span>
        </div>

        <div class="controls-row">
          <button class="ctl" id="mk-prev" aria-label="Previous track" title="Previous track"><span class="glyph prev" aria-hidden="true"></span></button>
          <button class="ctl" id="mk-play" aria-label="Play / Pause" title="Play / Pause" aria-pressed="false"><span class="glyph play" id="mk-play-glyph" aria-hidden="true"></span></button>
          <button class="ctl" id="mk-stop" aria-label="Stop" title="Stop"><span class="glyph stop" aria-hidden="true"></span></button>
          <button class="ctl" id="mk-next" aria-label="Next track" title="Next track"><span class="glyph next" aria-hidden="true"></span></button>

          <span class="ctl-sep" aria-hidden="true"></span>

          <button class="ctl" id="mk-mute" aria-label="Mute" title="Mute" aria-pressed="false"><span class="glyph unmute" id="mk-mute-glyph" aria-hidden="true"></span></button>
          <div class="volume" id="mk-volume" role="slider" tabindex="0"
               aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="60">
            <div class="vol-rail" aria-hidden="true"></div>
            <div class="vol-fill" id="mk-volfill" aria-hidden="true"></div>
            <div class="vol-thumb" id="mk-volthumb" aria-hidden="true"></div>
          </div>

          <span class="ctl-sep" aria-hidden="true"></span>

          <button class="ctl wide" id="mk-vis-toggle" aria-label="VIS (visualizer)" title="Visualizer" aria-pressed="false">VIS</button>
          <button class="ctl wide" id="mk-fs" aria-label="FS (fullscreen)" title="Fullscreen"><span aria-hidden="true">⛶&nbsp;</span>FS</button>
        </div>
      </div>
    </div>

    <!-- RIGHT: playlist -->
    <aside class="playlist" aria-label="Playlist">
      <div class="pl-header">
        <span class="pl-name">SHOP-TAPE.M3U</span>
        <span class="pl-meta" id="mk-pl-meta">{playlist.length} items</span>
      </div>
      <ol class="pl-list" id="mk-list" role="listbox" aria-label="Playlist tracks">
        {playlist.map((t, i) => (
          <li class:list={['pl-row', { 'is-current': i === 0 }]} role="option" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'} data-idx={i}>
            <span class="pl-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="pl-title"><span class="pl-name">{t.title}</span><span class="pl-artist">{t.artist}</span></span>
            {/* Empty until the track has loaded once: YouTube is the only
                source for a length, and it isn't asked before play. */}
            <span class="pl-dur">{t.dur}</span>
          </li>
        ))}
      </ol>
      <script type="application/json" id="mk-tracks" set:html={JSON.stringify(playlist)}></script>
      <div class="pl-toolbar" role="group" aria-label="Playlist toolbar">
        <button class="ctl" id="mk-shuffle" aria-pressed="false" title="Shuffle">⤭ SHUF</button>
        <button class="ctl" id="mk-repeat"  aria-pressed="true"  title="Repeat all">↻ RPT</button>
        <button class="ctl" title="The playlist is fixed" disabled>+ ADD</button>
        <button class="ctl" id="mk-skin" title="Cycle player skin">◆ SKIN</button>
        <span class="lab" id="mk-pl-status">queued</span>
      </div>
    </aside>
  </div>

  <!-- App status bar -->
  <div class="app-statusbar mk-status">
    <span class="seg"><span class="led" id="mk-led"></span><span id="mk-state">Idle</span></span>
    <span class="seg" id="mk-codec">Codec: H.264 (sorta)</span>
    <span class="seg" id="mk-buffer-pct">Buffer: 0%</span>
    <span class="seg">Net: <span class="meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span> Cable Modem (24 kbps)</span>
  </div>
</section>

<style is:global>
  /* ===========================================================
     MEDIAKRUZER 7.0 — local styles only. Builds on site.css.
     All selectors are scoped under body.mediakruzer-page so
     they only apply on the MK page, not site-wide.
     =========================================================== */

  /* CSS custom properties — scoped to the MK page body */
  body.mediakruzer-page {
    --mk-chrome-1: #5a8dd6;   /* WMP-blue title gradient top */
    --mk-chrome-2: #1f4a8a;   /* WMP-blue title gradient bot */
    --mk-chrome-edge: #0d2747;
    --mk-chrome-ink: #fff;    /* playlist header text */
    --mk-chrome-ink-shadow: rgba(0,0,0,0.4);
    --mk-lcd-bg: #0e1410;
    --mk-lcd-ink: #a4f09d;
    --mk-lcd-ink-dim: #2c4a2a;
    --mk-tab-bg: #cfd6da;
    --mk-tab-active: #ece1cb;
    --mk-rail: #6b7a86;
    --mk-rail-trough: #1a2128;
    --mk-buffer: #888a7a;
    --mk-progress: #9a2257;
    --mk-vu-low: #5cae3c;
    --mk-vu-mid: #d6c11a;
    --mk-vu-hi:  #c9243d;
    --mk-row: var(--accent-secondary); /* selected playlist row (white text) */
  }
  /* Dark mode: the lavender accent flips light; keep the selected row deep
     enough for its white text. */
  [data-theme="dark"] body.mediakruzer-page { --mk-row: #494786; }

  /* Skins. The SKIN button sets data-mk-skin on <html>, so the skin rules
     hang off html and override the defaults on body. Each skin re-tints the
     whole player, not one bar: the panel and bevel tokens (buttons, toolbar,
     status bar), the stage behind the video, the LCD ink (clocks, NO SIGNAL,
     VU), the playlist bar and the selected row. Text on every tinted face
     stays #1a1c1c (≥7:1); the selected rows keep white text (≥5:1). */

  /* RealKruzer: burnt orange and amber, like RealOne Player. */
  html[data-mk-skin="realkruzer"] body.mediakruzer-page {
    --bg-panel: #e3c49a;
    --bevel-light: #fff3e0;
    --bevel-edge: #4a1f02;
    --mk-tab-active: #f0dcc0;
    --mk-playlist: #f6e6cf; /* light mode only; dark keeps --bg-secondary */
    --mk-chrome-1: #b6520b;
    --mk-chrome-2: #7a3304;
    --mk-chrome-edge: #4a1f02;
    --mk-lcd-bg: #140c04;
    --mk-lcd-ink: #ffb347;
    --mk-lcd-ink-dim: #4a3010;
    --mk-progress: #d9650f;
    --mk-rail: #3a2a14;
    --mk-rail-trough: #14110a;
    --mk-vu-low: #f7a325;
    --mk-vu-mid: #e0661a;
    --mk-row: #7a3304;
  }
  /* QuickDingus: brushed silver with blue, like QuickTime. */
  html[data-mk-skin="quickdingus"] body.mediakruzer-page {
    --bg-panel: #c8ccd2;
    --bevel-light: #ffffff;
    --bevel-edge: #3d4249;
    --mk-tab-active: #e4e7eb;
    --mk-playlist: #eceef1;
    --mk-chrome-1: #f4f5f7;
    --mk-chrome-2: #9ea4ac;
    --mk-chrome-edge: #3d4249;
    --mk-chrome-ink: #1a1c1c; /* silver bar: dark text */
    --mk-chrome-ink-shadow: rgba(255,255,255,0.6);
    --mk-lcd-bg: #071216;
    --mk-lcd-ink: #8fe3ff;
    --mk-lcd-ink-dim: #1d3a44;
    --mk-progress: #2a6fdb;
    --mk-rail: #6b7079;
    --mk-rail-trough: #11161c;
    --mk-vu-low: #8fe3ff;
    --mk-vu-mid: #2a6fdb;
    --mk-row: #174a99;
  }
  /* Brushed metal: fine vertical streaks over the silver gradient. */
  html[data-mk-skin="quickdingus"] body.mediakruzer-page .pl-header,
  html[data-mk-skin="quickdingus"] body.mediakruzer-page .pl-toolbar,
  html[data-mk-skin="quickdingus"] body.mediakruzer-page .app-statusbar {
    background-image: repeating-linear-gradient(90deg, rgba(255,255,255,0.22) 0 1px, rgba(0,0,0,0.03) 1px 3px);
  }
  html[data-mk-skin="quickdingus"] body.mediakruzer-page .pl-header {
    background-image:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.22) 0 1px, rgba(0,0,0,0.03) 1px 3px),
      linear-gradient(180deg, var(--mk-chrome-1) 0%, var(--mk-chrome-2) 100%);
  }

  /* =========================================================
     MediaKruzer is its OWN application window on the desktop,
     not a panel inside the browser. The body gets `.mediakruzer-page`
     and we render two independent windows: KRIZSCAPE (minimized)
     and the player (focused, free-floating, draggable).
     ========================================================= */
  body.mediakruzer-page .app-window {
    background: var(--bg-panel);
    border: 2px solid;
    border-color: var(--bevel-light) var(--bevel-edge) var(--bevel-edge) var(--bevel-light);
    box-shadow:
      inset 1px 1px 0 var(--bg-panel-light),
      inset -1px -1px 0 var(--bg-panel-dark),
      4px 4px 0 rgba(0,0,0,0.35);
    display: flex; flex-direction: column;
    min-height: 0;
  }

  /* Free-floating on the desktop — sits above the .os-shell (z-30)
     and under the taskbar (z-50). The taskbar reserves 48px of
     viewport. Title bar is draggable via JS. */
  body.mediakruzer-page .app-window.mk-floating {
    position: fixed;
    top: var(--space-md);
    left: 0; right: 0;
    bottom: calc(48px + var(--space-md));
    margin: 0 auto;
    width: min(1120px, calc(100% - var(--space-md) * 2));
    z-index: 35;
  }
  body.mediakruzer-page .app-window.mk-floating.is-minimized { display: none !important; }
  body.mediakruzer-page .app-window.mk-floating.is-maximized {
    top: 0; left: 0; right: 0; bottom: 48px;
    width: auto; margin: 0;
  }

  /* The body of the floating window must scroll inside itself, not
     drag the page. Let app-body flex-grow & internally scroll the
     playlist column. */
  body.mediakruzer-page .app-window.mk-floating .app-body {
    flex: 1;
    min-height: 0;
  }
  body.mediakruzer-page .app-window.mk-floating .player-stage {
    overflow-y: auto;
    min-height: 0;
  }

  body.mediakruzer-page .title-bar { cursor: grab; }
  body.mediakruzer-page .title-bar.is-dragging { cursor: grabbing; }

  /* On this page, the browser window (.os-shell) starts minimized.
     Its taskbar entry is the restore handle. */
  body.mediakruzer-page .os-shell .window-content {
    background: var(--bg-secondary);
  }

  /* ---------- App-specific title-bar extras ----------
     Base .title-bar chrome + .window-btn controls live in site.css
     (same chrome as the .os-shell). We only style the MediaKruzer
     extras: the now-playing strip and the inline separator. */
  body.mediakruzer-page .app-window > .title-bar .title-label .sep {
    color: rgba(255,255,255,0.6); margin: 0 2px;
  }
  body.mediakruzer-page .app-window > .title-bar .title-label .now {
    color: var(--mk-lcd-ink); font-family: var(--font-crt);
    letter-spacing: 0;
    font-size: 14px;
    max-width: 50ch;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* ---------- (Tab strip removed — we never built those screens.) ---------- */

  /* ---------- App body: two columns ---------- */
  body.mediakruzer-page .app-body {
    background: var(--mk-tab-active);
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 0;
    border-top: 0;
    border-bottom: 2px solid var(--bevel-edge);
    min-height: 0;
  }
  @media (max-width: 880px) {
    body.mediakruzer-page .app-body { grid-template-columns: 1fr; }
  }

  /* ---------- Player stage (left column) ---------- */
  body.mediakruzer-page .player-stage {
    padding: 10px 10px 6px;
    display: flex; flex-direction: column; gap: 8px;
    min-width: 0;
    align-items: stretch;
  }

  body.mediakruzer-page .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 56vh;
    background: #000;
    border: 2px solid;
    border-color: var(--bevel-edge) var(--bevel-light) var(--bevel-light) var(--bevel-edge);
    box-shadow: inset 0 0 60px rgba(164,240,157,0.06), 0 0 0 1px #000;
    overflow: hidden;
    align-self: center;
    width: 100%;
  }
  /* Keep the video letterboxed within max-height by capping width via aspect ratio. */
  @supports (aspect-ratio: 16 / 9) {
    body.mediakruzer-page .video-frame { width: min(100%, calc(56vh * 16 / 9)); }
  }
  /* In its XP window (the embed fills the iframe), the screen takes the
     column's full width and whatever height the strip and transport leave,
     so it lines up with the panels below and no dead band opens under the
     transport. YouTube letterboxes inside the black frame. Single-column
     layouts (≤880px) keep the 16:9 box above. */
  @media (min-width: 881px) {
    /* The row is the window's height, not the playlist's: on a short
       screen (1024×768) the 11 rows used to stretch it past the status bar,
       and the transport drew over it. The playlist scrolls instead. */
    body.is-embed.mediakruzer-page .app-body { grid-template-rows: minmax(0, 1fr); }
    body.is-embed.mediakruzer-page .playlist { min-height: 0; }
    body.is-embed.mediakruzer-page .pl-list { min-height: 0; }
    body.is-embed.mediakruzer-page .video-frame {
      flex: 1 1 0;
      min-height: 220px;
      max-height: none;
      aspect-ratio: auto;
      width: 100%;
    }
  }
  body.mediakruzer-page .video-frame iframe,
  body.mediakruzer-page .video-frame #mk-yt {
    position: absolute; inset: 0;
    width: 100% !important; height: 100% !important; border: 0;
    background: #000;
  }
  body.mediakruzer-page .mk-nosignal {
    position: absolute; inset: 0; z-index: 3;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    width: 100%; border: 0; cursor: pointer;
    background: repeating-linear-gradient(0deg, #050805 0 2px, #0b120b 2px 4px);
    color: var(--mk-lcd-ink, #a4f09d);
    font-family: var(--font-mono);
  }
  body.mediakruzer-page .mk-nosignal__big { font-family: var(--font-pixel); font-size: 28px; letter-spacing: 0.2em; }
  body.mediakruzer-page .mk-nosignal__small { font-size: 12px; color: color-mix(in oklab, var(--mk-lcd-ink) 55%, #fff); }
  body.mediakruzer-page .mk-nosignal:focus-visible { outline: 2px dotted #c9f5c4; outline-offset: -6px; }
  body.mediakruzer-page .video-frame.is-tuned .mk-nosignal { display: none; }
  body.mediakruzer-page .video-frame .scanlines {
    position: absolute; inset: 0; pointer-events: none; z-index: 2;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0) 0 2px, rgba(0,0,0,0.18) 2px 3px);
    opacity: 0.45;
    mix-blend-mode: multiply;
  }
  body.mediakruzer-page .video-frame .vignette {
    position: absolute; inset: 0; pointer-events: none; z-index: 2;
    box-shadow: inset 0 0 80px rgba(0,0,0,0.55);
  }
  body.mediakruzer-page .video-frame .corner-stamp {
    position: absolute; left: 10px; bottom: 8px; z-index: 3;
    font-family: var(--font-pixel); font-size: 9px;
    letter-spacing: 0.08em;
    color: rgba(164,240,157,0.85);
    text-shadow: 0 0 4px rgba(164,240,157,0.6), 1px 1px 0 rgba(0,0,0,0.6);
    pointer-events: none;
  }

  /* Visualizer — animated bar columns over the video, toggleable */
  body.mediakruzer-page .vis-overlay {
    position: absolute; left: 0; right: 0; bottom: 0; height: 38%;
    display: none;
    align-items: flex-end; justify-content: center; gap: 3px;
    padding: 0 10px 10px;
    z-index: 4; pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 70%);
  }
  body.mediakruzer-page .vis-overlay.is-on { display: flex; }
  body.mediakruzer-page .vis-overlay .bar {
    flex: 1;
    max-width: 14px;
    background: linear-gradient(180deg, var(--mk-vu-hi) 0%, var(--mk-vu-mid) 35%, var(--mk-vu-low) 70%);
    height: 12%;
    box-shadow: 0 0 6px rgba(0,0,0,0.6);
    transition: height 120ms linear;
  }

  /* Now-playing strip — beneath the video, above the transport */
  body.mediakruzer-page .now-playing {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 10px; align-items: center;
    padding: 6px;
    background: var(--bg-tertiary);
    border: 2px solid;
    border-color: var(--bevel-edge) var(--bevel-light) var(--bevel-light) var(--bevel-edge);
  }
  body.mediakruzer-page .np-art {
    width: 56px; height: 56px;
    background: #1a1c1c center/cover no-repeat;
    border: 1px solid var(--bevel-edge);
    box-shadow: inset 0 0 0 1px var(--bevel-light);
    image-rendering: pixelated;
    color: #a4f09d;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-pixel); font-size: 18px;
  }
  body.mediakruzer-page .np-meta { min-width: 0; }
  body.mediakruzer-page .np-title {
    font-family: var(--font-pixel); font-size: 13px;
    color: var(--accent-primary);
    letter-spacing: var(--tracking-pixel);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  body.mediakruzer-page .np-sub {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--text-secondary);
    margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  body.mediakruzer-page .np-stats {
    font-family: var(--font-mono); font-size: 10px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  body.mediakruzer-page .np-stats .ok { color: var(--success); }
  /* VU meter — 10 bars, pulse while playing */
  body.mediakruzer-page .vu-meter {
    display: flex; align-items: flex-end; gap: 2px;
    width: 78px; height: 38px;
    background: var(--mk-lcd-bg);
    border: 1px solid var(--bevel-edge);
    box-shadow: inset 0 0 6px rgba(0,0,0,0.6);
    padding: 3px;
  }
  body.mediakruzer-page .vu-meter .vb {
    flex: 1;
    background: var(--mk-lcd-ink-dim);
    height: 8%;
  }
  body.mediakruzer-page .vu-meter.is-on .vb {
    transition: height 90ms linear, background 90ms linear;
  }

  /* =========================================================
     TRANSPORT BAR
     ========================================================= */
  body.mediakruzer-page .transport {
    display: flex; flex-direction: column; gap: 6px;
    padding: 6px 4px 4px;
  }

  body.mediakruzer-page .seek-row {
    display: grid;
