    padding: 6px 8px;
    background: linear-gradient(180deg, var(--mk-chrome-1) 0%, var(--mk-chrome-2) 100%);
    color: var(--mk-chrome-ink);
    font-family: var(--font-pixel); font-size: 10px;
    letter-spacing: var(--tracking-pixel);
    text-shadow: 1px 1px 0 var(--mk-chrome-ink-shadow);
    border-bottom: 2px solid var(--mk-chrome-edge);
  }
  body.mediakruzer-page .pl-header .pl-name { display: flex; align-items: center; gap: 6px; }
  body.mediakruzer-page .pl-header .pl-name::before {
    content: '▸'; font-size: 12px;
  }
  body.mediakruzer-page .pl-meta { font-size: 9px; opacity: 0.85; }

  body.mediakruzer-page .pl-list {
    list-style: none; padding: 0; margin: 0;
    flex: 1;
    overflow-y: auto;
    border-top: 1px solid var(--bevel-light);
