  /* Time-elapsed / time-total LCDs ride on the seek row.
     The position LCD overlays the scrubber on the LEFT, total on the right. */

  /* =========================================================
     PLAYLIST PANEL (right column)
     ========================================================= */
  body.mediakruzer-page .playlist {
