  body.mediakruzer-page .pl-toolbar .ctl { width: auto; padding: 0 8px; height: 22px; font-size: 11px; }
  body.mediakruzer-page .pl-toolbar .ctl[aria-pressed="true"] { background: var(--accent-pixel); }
  body.mediakruzer-page .pl-toolbar .lab {
    font-family: var(--font-mono); font-size: 10px; color: var(--text-secondary);
    margin-left: auto;
  }

  /* =========================================================
     APP STATUS BAR (the player's own footer — not the OS one)
     ========================================================= */
  body.mediakruzer-page .app-statusbar {
    display: flex; align-items: center; gap: 0;
    background: var(--bg-panel);
    font-family: var(--font-mono); font-size: 11px;
