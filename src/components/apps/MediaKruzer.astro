  body.mediakruzer-page .ctl:focus-visible {
    outline: 1px dotted #1a1c1c;
    outline-offset: -5px;
  }
  body.mediakruzer-page .ctl.wide { width: auto; padding: 0 10px; }
  /* Disabled control: greyed, etched text, no hover, no pointer. */
  body.mediakruzer-page .ctl:disabled {
    cursor: default;
    color: #808080;
    text-shadow: 1px 1px 0 #fff;
    filter: none;
  }
  body.mediakruzer-page .ctl:disabled:active {
    border-color: var(--bevel-light) var(--bevel-edge) var(--bevel-edge) var(--bevel-light);
    background: var(--bg-panel);
  }
  /* CSS-drawn glyphs */
  body.mediakruzer-page .glyph { display: inline-block; width: 14px; height: 14px; position: relative; }
  body.mediakruzer-page .glyph.prev::before, body.mediakruzer-page .glyph.next::before {
    content: ''; position: absolute; top: 50%; transform: translateY(-50%);
    width: 0; height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  body.mediakruzer-page .glyph.prev::before { left: 3px; border-right: 7px solid currentColor; }
  body.mediakruzer-page .glyph.next::before { right: 3px; border-left: 7px solid currentColor; }
  body.mediakruzer-page .glyph.prev::after, body.mediakruzer-page .glyph.next::after {
    content: ''; position: absolute; top: 2px; bottom: 2px; width: 2px;
    background: currentColor;
  }
  body.mediakruzer-page .glyph.prev::after { left: 1px; }
  body.mediakruzer-page .glyph.next::after { right: 1px; }
  body.mediakruzer-page .glyph.play::before {
    content: ''; position: absolute; left: 3px; top: 50%; transform: translateY(-50%);
    width: 0; height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 9px solid currentColor;
  }
  body.mediakruzer-page .glyph.pause::before, body.mediakruzer-page .glyph.pause::after {
    content: ''; position: absolute; top: 2px; bottom: 2px; width: 3px;
    background: currentColor;
  }
  body.mediakruzer-page .glyph.pause::before { left: 3px; }
  body.mediakruzer-page .glyph.pause::after  { right: 3px; }
  body.mediakruzer-page .glyph.stop::before {
    content: ''; position: absolute; inset: 3px;
    background: currentColor;
  }
  /* Speaker: a small box plus a cone, drawn like the other glyphs; the
     ::after is the sound (")") or the mute cross ("×"). */
  body.mediakruzer-page .glyph.mute::before, body.mediakruzer-page .glyph.unmute::before {
    content: ''; position: absolute; left: 1px; top: 50%; transform: translateY(-50%);
    width: 3px; height: 4px;
    background: currentColor; background-clip: content-box;
    border-right: 5px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }
  body.mediakruzer-page .glyph.mute::after, body.mediakruzer-page .glyph.unmute::after {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    font: 700 11px/1 var(--font-mono);
