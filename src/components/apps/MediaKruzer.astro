    body.mediakruzer-page .ctl { width: 34px; height: 30px; }
    body.mediakruzer-page .volume { width: 84px; }
    body.mediakruzer-page .lcd { font-size: 14px; min-width: 50px; }
    body.mediakruzer-page .playlist { border-left: 0; border-top: 2px solid var(--bevel-edge); }
    body.mediakruzer-page .pl-list { max-height: 220px; }
