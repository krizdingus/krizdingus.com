    border-left: 5px solid #fff;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
  }
</style>

<script is:inline>
  // MediaKruzer 7.0 — controller. The playlist is already in the page
  // (#mk-tracks, rendered at build time). Nothing talks to YouTube until the
  // visitor presses play or picks a track: then the IFrame API loads and a
  // youtube-nocookie player replaces #mk-yt. Track and position are kept in
  // sessionStorage, so the player reopens where it was, paused.
  (function () {
    'use strict';

    var SS_KEY = 'mediakruzer-state';
    var PLAYLIST = [];
    try { PLAYLIST = JSON.parse(document.getElementById('mk-tracks').textContent || '[]'); } catch (e) {}

    var current = 0;
    var resumeAt = 0;
    var player = null;
    var playerReady = false;
    var apiRequested = false;
    var wantPlay = false;
    var isShuffle = false;
    var isRepeat = true;
    var pollT = null;
    var visT = null;
    var vuT = null;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function $(id) { return document.getElementById(id); }
    function fmt(sec) {
      sec = Math.max(0, Math.floor(sec || 0));
      var m = Math.floor(sec / 60), s = sec % 60;
      return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    }
    function clamp(n, lo, hi) { return Math.min(hi, Math.max(lo, n)); }
    function setText(id, txt) { var el = $(id); if (el) el.textContent = txt; }

    // ---------- remembered state ----------
    function saveState(t) {
      try { sessionStorage.setItem(SS_KEY, JSON.stringify({ i: current, t: Math.floor(t || 0) })); } catch (e) {}
    }
    function loadState() {
      try {
        var s = JSON.parse(sessionStorage.getItem(SS_KEY) || 'null');
        if (s && typeof s.i === 'number' && s.i >= 0 && s.i < PLAYLIST.length) {
          current = s.i;
          resumeAt = typeof s.t === 'number' && s.t > 0 ? s.t : 0;
        }
      } catch (e) {}
    }
    function currentTime() {
      if (playerReady && player && player.getCurrentTime) {
        try { return player.getCurrentTime() || 0; } catch (e) {}
      }
      return resumeAt;
    }

    // ---------- playlist ----------
    function rows() { return Array.prototype.slice.call(document.querySelectorAll('#mk-list .pl-row')); }
    function syncList() {
      rows().forEach(function (li, i) {
        var on = i === current;
        li.classList.toggle('is-current', on);
        li.setAttribute('aria-selected', on ? 'true' : 'false');
        li.tabIndex = on ? 0 : -1;
      });
    }
    function updateNowPlaying() {
      var t = PLAYLIST[current];
      if (!t) return;
      setText('mk-now-title', '[Now Playing] ' + t.title);
      setText('mk-meta-title', t.title);
      setText('mk-meta-sub', t.artist);
      var art = $('mk-art');
      if (art) {
        // The thumbnail comes from YouTube, so it waits for a play too.
        if (player) {
          art.style.backgroundImage = 'url("https://i.ytimg.com/vi/' + t.id + '/hqdefault.jpg")';
          art.textContent = '';
        } else {
          art.style.backgroundImage = '';
          art.textContent = '▣';
        }
      }
      syncList();
    }
    function bindList() {
      var ol = $('mk-list');
      if (!ol) return;
      ol.addEventListener('click', function (e) {
        var li = e.target.closest && e.target.closest('.pl-row');
        if (li) load(parseInt(li.dataset.idx, 10), true);
      });
      ol.addEventListener('keydown', function (e) {
        var li = e.target.closest && e.target.closest('.pl-row');
        if (!li) return;
        var all = rows(), i = all.indexOf(li), n = null;
        if (e.key === 'ArrowDown') n = Math.min(all.length - 1, i + 1);
        else if (e.key === 'ArrowUp') n = Math.max(0, i - 1);
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = all.length - 1;
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); load(i, true); return; }
        if (n === null) return;
        e.preventDefault();
        all.forEach(function (r, j) { r.tabIndex = j === n ? 0 : -1; });
        all[n].focus();
      });
    }

    // ---------- YouTube, on demand ----------
    function requestApi() {
      if (apiRequested) return;
      apiRequested = true;
      setText('mk-state', 'Connecting…');
      setText('mk-pl-status', 'dialing up');
      if (window.YT && window.YT.Player) { createPlayer(); return; }
      window.onYouTubeIframeAPIReady = createPlayer;
      var tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      tag.async = true;
      tag.onerror = function () {
        apiRequested = false;
        setText('mk-state', 'Offline');
        setText('mk-pl-status', '◊ could not reach YouTube ◊');
      };
      document.body.appendChild(tag);
    }
    function createPlayer() {
      if (player || !PLAYLIST.length) return;
      var frame = $('mk-frame'); if (frame) frame.classList.add('is-tuned');
      player = new window.YT.Player('mk-yt', {
        host: 'https://www.youtube-nocookie.com',
        width: '100%',
        height: '100%',
        videoId: PLAYLIST[current].id,
        playerVars: {
          rel: 0, modestbranding: 1, playsinline: 1,
          enablejsapi: 1, origin: location.origin, fs: 1,
          start: Math.floor(resumeAt)
        },
        events: { onReady: onReady, onStateChange: onState, onError: onError }
      });
      updateNowPlaying();
    }
    function onReady() {
      playerReady = true;
      player.setVolume(parseInt(($('mk-volume') || {}).getAttribute ? $('mk-volume').getAttribute('aria-valuenow') : 60, 10) || 60);
      startPoll();
      if (wantPlay) { wantPlay = false; player.playVideo(); }
    }

    function onState(ev) {
      var s = ev.data, YTS = window.YT.PlayerState;
      var led = $('mk-led'), glyph = $('mk-play-glyph'), play = $('mk-play');
      if (!led || !glyph || !play) return;
      led.className = 'led';
      if (s === YTS.PLAYING) {
        setText('mk-state', 'Streaming');
        glyph.className = 'glyph pause';
        play.setAttribute('aria-pressed', 'true');
        setText('mk-pl-status', 'playing track ' + (current + 1) + '/' + PLAYLIST.length);
        startVis(); startVU();
      } else if (s === YTS.PAUSED) {
        led.classList.add('idle');
        setText('mk-state', 'Paused');
        glyph.className = 'glyph play';
        play.setAttribute('aria-pressed', 'false');
        setText('mk-pl-status', 'paused');
        stopVis(); stopVU();
        saveState(currentTime());
      } else if (s === YTS.BUFFERING) {
        led.classList.add('buffering');
        setText('mk-state', 'Buffering…');
        setText('mk-pl-status', 'buffering');
      } else if (s === YTS.ENDED) {
        led.classList.add('idle');
        setText('mk-state', 'Ended');
        glyph.className = 'glyph play';
        play.setAttribute('aria-pressed', 'false');
        stopVis(); stopVU();
        advance(+1, isRepeat);
      } else {
        led.classList.add('idle');
        setText('mk-state', 'Idle');
      }
    }
    function onError(ev) {
      setText('mk-state', 'Error ' + ev.data);
      setText('mk-pl-status', '◊ playback failure ◊');
    }

    // ---------- transport ----------
    function play() {
      if (playerReady) { player.playVideo(); return; }
      wantPlay = true;
      requestApi();
    }
    function pause() { if (playerReady) player.pauseVideo(); }
    // The XP desktop asks for quiet before a reboot (src/themes/xp/apps.ts),
    // so nothing keeps playing behind the boot screen.
    window.addEventListener('message', function (e) {
      if (e.origin === location.origin && e.data && e.data.type === 'krizapps:pause') pause();
    });
    function togglePlay() {
      if (!playerReady) { play(); return; }
      if (player.getPlayerState() === window.YT.PlayerState.PLAYING) pause(); else play();
    }
    function resetLcd() {
      setText('mk-lcd-pos', '00:00');
      var p = $('mk-progress'), th = $('mk-thumb');
      if (p) p.style.width = '0%';
      if (th) th.style.left = '0%';
    }
    function stop() {
      resumeAt = 0;
      saveState(0);
      resetLcd();
      if (playerReady) player.stopVideo();
    }
    function load(idx, autoplay) {
      if (!PLAYLIST.length) return;
      current = ((idx % PLAYLIST.length) + PLAYLIST.length) % PLAYLIST.length;
      resumeAt = 0;
      saveState(0);
      resetLcd();
      setText('mk-lcd-dur', PLAYLIST[current].dur || '00:00');
      updateNowPlaying();
      if (!playerReady) {
        if (autoplay) play();
        else if (player) wantPlay = false;
        return;
      }
      if (autoplay) player.loadVideoById(PLAYLIST[current].id);
      else player.cueVideoById(PLAYLIST[current].id);
    }
    function advance(dir, autoplay) {
      if (isShuffle && PLAYLIST.length > 1) {
        var n = current;
        while (n === current) n = Math.floor(Math.random() * PLAYLIST.length);
        return load(n, autoplay);
      }
      var next = current + dir;
      if (next < 0) next = isRepeat ? PLAYLIST.length - 1 : 0;
      if (next >= PLAYLIST.length) next = isRepeat ? 0 : PLAYLIST.length - 1;
      load(next, autoplay);
    }

    // ---------- poll loop ----------
    function startPoll() {
      if (pollT) return;
      pollT = setInterval(function () {
        if (!playerReady) return;
        var cur = 0, dur = 0, buf = 0;
        try {
          cur = player.getCurrentTime() || 0;
          dur = player.getDuration() || 0;
          buf = player.getVideoLoadedFraction() || 0;
        } catch (e) {}
        setText('mk-lcd-pos', fmt(cur));
        setText('mk-lcd-dur', fmt(dur));
        var pct = dur > 0 ? (cur / dur) * 100 : 0;
        $('mk-progress').style.width = pct + '%';
        $('mk-thumb').style.left = pct + '%';
        $('mk-buffer').style.width = (buf * 100) + '%';
        setText('mk-buffer-pct', 'Buffer: ' + Math.round(buf * 100) + '%');
        $('mk-scrub').setAttribute('aria-valuenow', Math.round(pct));
        $('mk-scrub').setAttribute('aria-valuetext', fmt(cur) + ' of ' + fmt(dur));
        if (dur && PLAYLIST[current] && !PLAYLIST[current].dur) {
          PLAYLIST[current].dur = fmt(dur);
          var r = rows()[current];
          if (r) r.querySelector('.pl-dur').textContent = fmt(dur);
        }
        if (cur) saveState(cur);
      }, 500);
    }

    // ---------- visualizer + VU (decoration; still under reduced motion) ----------
    function startVis() {
      if (visT || reduced) return;
      var box = $('mk-vis');
      if (!box) return;
      if (!box.children.length) {
        for (var i = 0; i < 24; i++) box.appendChild(document.createElement('span')).className = 'bar';
      }
      var bars = box.querySelectorAll('.bar');
      visT = setInterval(function () {
        bars.forEach(function (b, i) {
          var base = 12 + Math.sin((Date.now() / 280) + i * 0.6) * 20;
          b.style.height = clamp(base + Math.random() * 65, 8, 95) + '%';
        });
      }, 110);
    }
    function stopVis() {
      clearInterval(visT); visT = null;
      var box = $('mk-vis');
      if (box) box.querySelectorAll('.bar').forEach(function (b) { b.style.height = '8%'; });
    }
    function setVisOn(on) {
      var box = $('mk-vis');
      if (!box) return;
      box.classList.toggle('is-on', on);
      $('mk-vis-toggle').setAttribute('aria-pressed', on ? 'true' : 'false');
      if (on) startVis(); else stopVis();
    }
    function startVU() {
      var box = $('mk-vu');
      if (!box || reduced) return;
      box.classList.add('is-on');
      if (vuT) return;
      var bars = box.querySelectorAll('.vb');
      vuT = setInterval(function () {
        bars.forEach(function (b, i) {
          var h = clamp(18 + Math.random() * 78 + Math.sin((Date.now() / 220) + i) * 8, 10, 96);
          b.style.height = h + '%';
          b.style.background = h > 75 ? 'var(--mk-vu-hi)' : (h > 45 ? 'var(--mk-vu-mid)' : 'var(--mk-vu-low)');
        });
      }, 120);
    }
    function stopVU() {
      clearInterval(vuT); vuT = null;
      var box = $('mk-vu');
      if (!box) return;
      box.classList.remove('is-on');
      box.querySelectorAll('.vb').forEach(function (b) { b.style.height = '8%'; b.style.background = 'var(--mk-lcd-ink-dim)'; });
    }

    // ---------- scrubber ----------
    function bindScrub() {
      var rail = $('mk-scrub');
      if (!rail) return;
      function pctFromEvent(e) {
        var r = rail.getBoundingClientRect();
        var x = (e.touches ? e.touches[0].clientX : e.clientX) - r.left;
        return clamp(x / r.width, 0, 1);
      }
      function commit(p) {
        if (!playerReady) return;
        var dur = player.getDuration() || 0;
        if (!dur) return;
        player.seekTo(p * dur, true);
        $('mk-progress').style.width = (p * 100) + '%';
        $('mk-thumb').style.left = (p * 100) + '%';
        setText('mk-lcd-pos', fmt(p * dur));
      }
      var dragging = false;
      rail.addEventListener('mousedown', function (e) { dragging = true; commit(pctFromEvent(e)); });
      window.addEventListener('mousemove', function (e) { if (dragging) commit(pctFromEvent(e)); });
      window.addEventListener('mouseup', function () { dragging = false; });
      rail.addEventListener('touchstart', function (e) { commit(pctFromEvent(e)); }, { passive: true });
      rail.addEventListener('touchmove', function (e) { commit(pctFromEvent(e)); }, { passive: true });
      rail.addEventListener('keydown', function (e) {
        if (!playerReady) return;
        var dur = player.getDuration() || 0;
        if (!dur) return;
        var cur = player.getCurrentTime() || 0;
        if (e.key === 'ArrowLeft') { player.seekTo(Math.max(0, cur - 5), true); e.preventDefault(); }
        if (e.key === 'ArrowRight') { player.seekTo(Math.min(dur, cur + 5), true); e.preventDefault(); }
        if (e.key === 'Home') { player.seekTo(0, true); e.preventDefault(); }
        if (e.key === 'End') { player.seekTo(dur - 1, true); e.preventDefault(); }
      });
    }

    // ---------- volume ----------
    function bindVolume() {
      var v = $('mk-volume');
      if (!v) return;
      function setVol(p) {
        p = clamp(p, 0, 1);
        $('mk-volfill').style.width = (p * 100) + '%';
        $('mk-volthumb').style.left = (p * 100) + '%';
        v.setAttribute('aria-valuenow', Math.round(p * 100));
        $('mk-mute').setAttribute('aria-pressed', p === 0 ? 'true' : 'false');
        $('mk-mute-glyph').className = 'glyph ' + (p === 0 ? 'mute' : 'unmute');
        if (playerReady) {
          player.setVolume(p * 100);
          if (p === 0) player.mute(); else if (player.isMuted()) player.unMute();
        }
      }
      function pctFromEvent(e) {
        var r = v.getBoundingClientRect();
        return clamp((e.clientX - r.left) / r.width, 0, 1);
      }
      var drag = false;
      v.addEventListener('mousedown', function (e) { drag = true; setVol(pctFromEvent(e)); });
      window.addEventListener('mousemove', function (e) { if (drag) setVol(pctFromEvent(e)); });
      window.addEventListener('mouseup', function () { drag = false; });
      v.addEventListener('keydown', function (e) {
        var cur = parseInt(v.getAttribute('aria-valuenow') || '60', 10);
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { setVol((cur - 5) / 100); e.preventDefault(); }
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { setVol((cur + 5) / 100); e.preventDefault(); }
      });
    }

    // ---------- buttons ----------
    function on(id, fn) { var el = $(id); if (el) el.addEventListener('click', fn); }
    function bindButtons() {
      on('mk-prev', function () { advance(-1, !!playerReady); });
      on('mk-play', togglePlay);
      on('mk-nosignal', play);
      on('mk-stop', stop);
      on('mk-next', function () { advance(+1, !!playerReady); });
      on('mk-mute', function () {
        if (!playerReady) return;
        var muted = player.isMuted();
        if (muted) player.unMute(); else player.mute();
        $('mk-mute').setAttribute('aria-pressed', muted ? 'false' : 'true');
        $('mk-mute-glyph').className = 'glyph ' + (muted ? 'unmute' : 'mute');
      });
      on('mk-vis-toggle', function () { setVisOn(!$('mk-vis').classList.contains('is-on')); });
      on('mk-fs', function () {
        var frame = $('mk-frame');
        if (document.fullscreenElement) document.exitFullscreen();
        else if (frame.requestFullscreen) frame.requestFullscreen().catch(function () {});
      });
      on('mk-shuffle', function () {
        isShuffle = !isShuffle;
        $('mk-shuffle').setAttribute('aria-pressed', isShuffle ? 'true' : 'false');
      });
      on('mk-repeat', function () {
        isRepeat = !isRepeat;
        $('mk-repeat').setAttribute('aria-pressed', isRepeat ? 'true' : 'false');
      });

      var SKINS = ['default', 'realkruzer', 'quickdingus'];
      var skinBtn = $('mk-skin');
      function refreshSkinBtn() {
        if (!skinBtn) return;
        var cur = document.documentElement.getAttribute('data-mk-skin') || 'default';
        skinBtn.title = 'Skin: ' + cur.toUpperCase() + ' (click to cycle)';
      }
      try {
        var stored = localStorage.getItem('mediakruzer-skin');
        if (stored && stored !== 'default' && SKINS.indexOf(stored) > 0) document.documentElement.setAttribute('data-mk-skin', stored);
      } catch (e) {}
      refreshSkinBtn();
      if (skinBtn) skinBtn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-mk-skin') || 'default';
        var next = SKINS[(SKINS.indexOf(cur) + 1) % SKINS.length];
        if (next === 'default') document.documentElement.removeAttribute('data-mk-skin');
        else document.documentElement.setAttribute('data-mk-skin', next);
        try { localStorage.setItem('mediakruzer-skin', next); } catch (e) {}
        setText('mk-pl-status', 'skin: ' + next);
        refreshSkinBtn();
      });
    }

    // The window is about to go (navigation, close): keep the spot.
    window.addEventListener('pagehide', function () { saveState(currentTime()); });

    function boot() {
      loadState();
      updateNowPlaying();
      setText('mk-lcd-pos', fmt(resumeAt));
      setText('mk-lcd-dur', (PLAYLIST[current] && PLAYLIST[current].dur) || '00:00');
      if (resumeAt) setText('mk-pl-status', 'paused at ' + fmt(resumeAt));
      bindList();
      bindScrub();
      bindVolume();
      bindButtons();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
</script>
