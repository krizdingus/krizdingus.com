  body.mediakruzer-page .glyph.unmute::after { content: ')'; }
  body.mediakruzer-page .glyph.mute::after { content: '\00d7'; }

  body.mediakruzer-page .ctl-sep {
    width: 2px; height: 22px; align-self: center;
    background: var(--bevel-edge);
    box-shadow: 1px 0 0 var(--bevel-light);
