  body.mediakruzer-page .pl-row:hover { background: rgba(74,71,134,0.10); }
  body.mediakruzer-page .pl-row:focus-visible { outline: 2px dotted currentColor; outline-offset: -3px; }
  body.mediakruzer-page .ctl:focus-visible,
  body.mediakruzer-page .scrub:focus-visible,
  body.mediakruzer-page .volume:focus-visible { outline: 2px dotted #1a1c1c; outline-offset: 2px; }
  body.mediakruzer-page .pl-row.is-current {
    background: var(--mk-row);
    color: #fff;
  }
  body.mediakruzer-page .pl-row.is-current .pl-num { color: var(--mk-lcd-ink); }
  body.mediakruzer-page .pl-row.is-current .pl-dur { color: #fff; }
  body.mediakruzer-page .pl-row .pl-num {
    font-family: var(--font-crt); font-size: 14px;
