    background: var(--mk-lcd-bg);
    border: 2px solid;
    border-color: var(--bevel-edge) var(--bevel-light) var(--bevel-light) var(--bevel-edge);
    padding: 2px 8px 0;
    letter-spacing: 0.05em;
    text-shadow: 0 0 4px color-mix(in oklab, var(--mk-lcd-ink) 55%, transparent);
    min-width: 64px; text-align: center;
    line-height: 1.1;
  }
  body.mediakruzer-page .lcd::before { content: ''; }

  body.mediakruzer-page .scrub {
    position: relative;
    height: 16px;
    background: var(--mk-rail-trough);
    border: 2px solid;
    border-color: var(--bevel-edge) var(--bevel-light) var(--bevel-light) var(--bevel-edge);
