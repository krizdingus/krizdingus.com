  body.mediakruzer-page .scrub .buffer {
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 0;
    background: repeating-linear-gradient(135deg, var(--mk-buffer) 0 4px, #6e7064 4px 8px);
  }
  body.mediakruzer-page .scrub .progress {
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 0;
    background: linear-gradient(180deg, color-mix(in oklab, var(--mk-progress) 80%, #fff) 0%, var(--mk-progress) 100%);
  }
  body.mediakruzer-page .scrub .thumb {
    position: absolute; top: 50%; left: 0;
    width: 10px; height: 16px;
    background: linear-gradient(180deg, #fff 0%, #b8b4ad 50%, #6b6660 100%);
    border: 1px solid #1a1c1c;
    transform: translate(-50%, -50%);
    cursor: ew-resize;
  }

  /* Buttons row — chunky beveled transport buttons */
  body.mediakruzer-page .controls-row {
    display: flex; align-items: center; gap: 4px;
    flex-wrap: wrap;
  }
  body.mediakruzer-page .ctl {
    background: var(--bg-panel);
    border: 2px solid;
    border-color: var(--bevel-light) var(--bevel-edge) var(--bevel-edge) var(--bevel-light);
    width: 38px; height: 32px;
