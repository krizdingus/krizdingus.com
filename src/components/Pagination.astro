---
// src/components/Pagination.astro
export interface Props {
  current: number;
  total: number;
  baseHref: string;  // e.g. '/blog/'
}

const { current, total, baseHref } = Astro.props as Props;

function pageHref(page: number): string {
  return page === 1 ? baseHref : `${baseHref}${page}/`;
}

/** Compute which page numbers to show: always 1, current ± 1, and total. Ellipses fill gaps. */
function buildPages(cur: number, tot: number): Array<number | 'ellipsis'> {
  const set = new Set<number>([1, cur - 1, cur, cur + 1, tot]);
  const pages = Array.from(set).filter((p) => p >= 1 && p <= tot).sort((a, b) => a - b);
  const out: Array<number | 'ellipsis'> = [];
  for (let i = 0; i < pages.length; i++) {
    out.push(pages[i]);
    if (i + 1 < pages.length && pages[i + 1] - pages[i] > 1) out.push('ellipsis');
  }
  return out;
}

const pages = buildPages(current, total);
---

{total > 1 && (
  <nav class="pagi" aria-label="Pagination">
    {pages.map((p) =>
      p === 'ellipsis' ? (
        <span class="ellipsis">…</span>
      ) : p === current ? (
        <span class="current" aria-current="page">{p}</span>
      ) : (
        <a href={pageHref(p)}>{p}</a>
      )
    )}
    {current < total && (
      <a class="last" href={pageHref(total)} aria-label="Last page">&gt;&gt;</a>
    )}
  </nav>
)}
